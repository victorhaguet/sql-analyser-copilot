OPENAI_API_KEY=your_api_key_here
SQL_COPILOT_MODEL=gpt-5.2

# Optional
OPENAI_BASE_URL=
SQL_COPILOT_ANALYST_MODEL=gpt-5.2
SQL_COPILOT_INTENT_MODEL=gpt-5.2
SQL_COPILOT_AGENT_MODEL=gpt-5.2
SQL_COPILOT_DATABASES=[{"name":"chinook","path":"data/Chinook_Sqlite.sqlite","description":"Music store database with artists, albums, tracks, customers, invoices, and employees."}, {"name":"northwind","path":"data/northwind.db","description":"Business database with customers, orders, products, suppliers, employees, shippers, and sales data."}]

# Authentication (optional — creates initial admin account on first run)
INITIAL_ADMIN_USERNAME=change-me-on-first-login
INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# Tracing (optional — enables execution trace logging)
ENABLE_TRACE_LOGGING=false
TRACE_LOG_DIR=logs

# SQL generation agent loop guardrails (optional — defaults shown; see
# AGENTIC_SQL_GENERATION_PLAN.md Step 10)
SQL_AGENT_MAX_ITERATIONS_QUERY=6
SQL_AGENT_MAX_ITERATIONS_MODIFICATION=10
SQL_AGENT_MAX_PROBES=6
SQL_AGENT_MAX_CLARIFICATIONS=3
SQL_AGENT_PROBE_ROW_LIMIT=20
SQL_AGENT_RECURSION_LIMIT=40
# Unset by default (no truncation); set to cap format_full_schema's output.
SQL_AGENT_MAX_SCHEMA_CHARS=